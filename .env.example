# ==============================================================================
# ContextAI — Environment Variable Template
# ==============================================================================
# Copy this file to .env (or backend/.env) and populate with your credentials.
# NEVER commit .env or real credentials to source control.
# ==============================================================================

# OpenAI API Configuration
# Required: Your secret OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=replace_with_your_openai_api_key

# Model selection for OpenAI Responses API (default: gpt-6-luna)
OPENAI_MODEL=gpt-6-luna

# Database Configuration
# Local development default: SQLite database file (contextai.db)
# Production: Neon Serverless PostgreSQL connection string (postgresql+psycopg://...)
DATABASE_URL=sqlite:///./contextai.db

# Optional: Direct unpooled connection string used exclusively for Alembic migrations in Neon
DATABASE_URL_UNPOOLED=

# Application Environment (development | production)
# Note: For production deployments on Vercel, set APP_ENV=production in Vercel environment settings
APP_ENV=development

# Allowed CORS Origin for Frontend
FRONTEND_ORIGIN=http://localhost:3000

# Context Window & Memory Management
# Maximum number of recent messages sent to the LLM (must be >= 2)
MAX_CONTEXT_MESSAGES=12

# Threshold of active messages that triggers rolling summarization
SUMMARY_TRIGGER_MESSAGES=16

# Maximum allowed characters per user message (enforces HTTP 413)
MAX_MESSAGE_CHARS=8000

# Whether to archive older summarized turns (true) or permanently delete them (false)
ARCHIVE_OLD_MESSAGES=true
